pipeline {

    agent any

    tools {
        maven 'Maven3'
        jdk 'JDK17'
    }

    stages {

        stage('Checkout Code') {
            steps {
                git 'https://github.com/username/project.git'
            }
        }

        stage('Build Project') {
            steps {
                bat 'mvn clean'
            }
        }

        stage('Run TestNG Tests') {
            steps {
                bat 'mvn test'
            }
        }

    }

    post {

        always {
            archiveArtifacts artifacts: '**/*.png'
        }

        success {
            echo 'Test Execution Successful'
        }

        failure {
            echo 'Test Execution Failed'
        }
    }
}